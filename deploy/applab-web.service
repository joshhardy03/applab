[Unit]
Description=App Lab dashboard and web previews (gunicorn, port 5080)
After=network.target

[Service]
User=botuser
WorkingDirectory=/home/botuser/applab
EnvironmentFile=/home/botuser/applab/.env
# 1 worker: single user, and the box is short on memory
ExecStart=/home/botuser/applab/venv/bin/gunicorn -w 1 --threads 4 -b 127.0.0.1:5080 --timeout 60 wsgi:app
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
