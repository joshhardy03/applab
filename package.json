{
  "name": "applab",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test": "tsx --test packages/*/src/*.test.ts apps/*/src/*.test.ts",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "tsx": "~4.23.15",
    "typescript": "~6.0.3"
  }
}
