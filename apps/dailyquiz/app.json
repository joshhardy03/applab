{
  "expo": {
    "name": "Daily Quiz Tracker",
    "slug": "dailyquiz",
    "version": "0.2.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "uk.tradebot.dailyquiz",
      "supportsTablet": false
    },
    "android": {
      "package": "uk.tradebot.dailyquiz"
    },
    "web": {
      "output": "single",
      "bundler": "metro",
      "name": "Daily Quiz Tracker",
      "shortName": "Daily Quiz",
      "themeColor": "#3b5bdb"
    },
    "experiments": {
      "baseUrl": "/preview/dailyquiz"
    },
    "scheme": "dailyquiz",
    "plugins": [
      "expo-notifications"
    ]
  }
}
